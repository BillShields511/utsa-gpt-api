# Firebase / GCP service account keys — never commit these.
# Patterns without a slash match at any depth, which the previous
# "backend\...json" entry did not: gitignore uses forward slashes only,
# so that line matched nothing and the key was unprotected.
utsa-gpt-*.json
*service-account*.json
.firebaserc

# Secrets
.env
*.env

# Python
*.pyc
__pycache__/
.venv/
venv/

# Local caches / large artifacts
vectors_cache.json
chromedriver
chromedriver.exe

# Editor / tooling
.claude/
.vscode/
.DS_Store
